# Non-sensitive Cloud Run configuration.
#
# Copy to env.production.yaml, edit, and pass with:
#   gcloud run jobs create/update ... --env-vars-file=env.production.yaml
#
# SMTP_PASS and GEMINI_API_KEY are deliberately absent — those come from Secret
# Manager via --set-secrets. Never add them here.
#
# A YAML file is used rather than --set-env-vars because several values contain
# commas and "@", which collide with that flag's delimiter syntax.

# ── State (required on Cloud Run) ─────────────────────────────────────────────
# Without STATE_BUCKET the SQLite file dies with the container and every run
# re-emails the whole lookback window.
STATE_BUCKET: "PROJECT_ID-nse-tracker-state"
STATE_OBJECT: "circulars.db"
DB_PATH: "/tmp/data/circulars.db"

# ── NSE scraping ──────────────────────────────────────────────────────────────
NSE_DEPT: "MF"
NSE_LOOKBACK_DAYS: "7"
NSE_RETRY_DELAY_SECONDS: "5"
NSE_MAX_RETRIES: "4"

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST: "smtp.gmail.com"
SMTP_PORT: "465"
SMTP_SECURE: "true"
SMTP_USER: "you@example.com"
MAIL_FROM: "NSE Circular Tracker <you@example.com>"
MAIL_TO: "ops@example.com,compliance@example.com"
MAIL_CC: ""
NOTIFY_ON_ROUTINE: "false"
MAIL_DRY_RUN: "false"

# ── Classification ────────────────────────────────────────────────────────────
CRITICAL_THRESHOLD: "6"
IMPORTANT_THRESHOLD: "3"
LLM_BAND_MIN: "0"
LLM_BAND_MAX: "2"
GEMINI_MODEL: "gemini-3.6-flash"
GEMINI_THINKING_LEVEL: "LOW"

# ── API documentation tracking ────────────────────────────────────────────────
TRACK_API_DOCS: "true"
APIDOC_PAGE_URL: "https://www.nseinvest.com/nsemfdesk/login.htm"
APIDOC_VERIFY_LINK: "true"
# APIDOC_LINK_PATTERN only needs setting if NSE renames the document; the
# built-in default already matches NSEMF_API_Details_V<version>.pdf
# APIDOC_LINK_PATTERN: "NSEMF_API_Details_V([0-9]+(?:\\.[0-9]+)*)\\.pdf"

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL: "info"
