# ─── NSE scraping ───────────────────────────────────────────────────────────
# Department code on the circulars API. MF = Mutual Fund.
NSE_DEPT=MF
# How many days back each scheduled run looks. Keep a few days of overlap so a
# missed run (machine asleep, network down) self-heals on the next run.
NSE_LOOKBACK_DAYS=7
# Seconds to wait between HTTP retries against NSE (it rate-limits aggressively).
NSE_RETRY_DELAY_SECONDS=5
NSE_MAX_RETRIES=4

# ─── Storage ────────────────────────────────────────────────────────────────
DB_PATH=./data/circulars.db

# ─── Scheduling ─────────────────────────────────────────────────────────────
# Standard 5-field cron. Default: 08:30 every weekday (NSE publishes on business days).
CRON_SCHEDULE=30 8 * * 1-5
CRON_TIMEZONE=Asia/Kolkata
# Run one cycle immediately when the daemon starts, instead of waiting for the
# first cron tick.
RUN_ON_START=true

# ─── Email (SMTP via nodemailer) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=you@example.com
# Gmail: use an App Password, not your account password.
SMTP_PASS=your-app-password
MAIL_FROM="NSE Circular Tracker <you@example.com>"
# Comma-separated. These get every alert.
MAIL_TO=ops@example.com,compliance@example.com
# Comma-separated, optional.
MAIL_CC=
# Send an alert even when a run finds only routine circulars.
NOTIFY_ON_ROUTINE=false
# Set to true to log emails instead of sending them (useful for a dry run).
MAIL_DRY_RUN=false

# ─── Importance classification ──────────────────────────────────────────────
# Score at or above this is CRITICAL; at or above IMPORTANT_THRESHOLD is IMPORTANT.
CRITICAL_THRESHOLD=6
IMPORTANT_THRESHOLD=3
# Rule scores landing in this band are ambiguous and get sent to Gemini.
# 0 means "no keyword matched at all" — in practice the most uncertain case
# (scheme mergers, SIP minimum changes), so the band starts there. Negative
# scores are confidently routine NFO/admin notices and never reach the model.
LLM_BAND_MIN=0
LLM_BAND_MAX=2
# Leave GEMINI_API_KEY unset to disable the LLM fallback entirely — the tracker
# then runs on keyword rules alone. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Thinking depth for the classifier: MINIMAL | LOW | MEDIUM | HIGH, or OFF to
# omit thinking controls entirely (use OFF if your model rejects them).
GEMINI_THINKING_LEVEL=LOW

# ─── NSE MF Desk API documentation tracking ────────────────────────────────
# Watches the "API STRUCTURE" menu on NSE MF Desk and emails when the API
# specification document's version number increases.
TRACK_API_DOCS=true
APIDOC_PAGE_URL=https://www.nseinvest.com/nsemfdesk/login.htm
# Regex matched against every href on that page. The FIRST capture group must be
# the version. Change this if NSE renames the document.
APIDOC_LINK_PATTERN=NSEMF_API_Details_V([0-9]+(?:\.[0-9]+)*)\.pdf
# Confirm the document URL resolves before emailing it (1-byte ranged GET).
APIDOC_VERIFY_LINK=true

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
